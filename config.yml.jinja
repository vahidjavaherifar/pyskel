blank_issues_enabled: false

contact_links:
  - name: Questions & Community Support
    url: https://github.com/{{ github_username }}/{{ github_repo }}/discussions/categories/q-a
    about: Ask usage questions, get installation help, or discuss technical topics with the community.

  - name: Security Vulnerability Report
    url: https://github.com/{{ github_username }}/{{ github_repo }}/security/advisories/new
    about: Privately report security flaws or vulnerabilities (do NOT open a public issue).

  - name: Ideas & Feature Discussions
    url: https://github.com/{{ github_username }}/{{ github_repo }}/discussions/categories/ideas
    about: Brainstorm potential features or architectural concepts before opening a formal request.

  - name: Documentation & Specifications
    url: https://github.com/{{ github_username }}/{{ github_repo }}/wiki
    about: Access manuals, API references, design decisions, and ecosystem style guides.
